		<platform name="Android-ARM">
			<applicationDeployment>
				<nativeLibrary>com.bumptech.glide.android.jar</nativeLibrary>
				<initializer>com.distriqt.extension.bumptech.glide.GlideExtension</initializer>
				<finalizer>com.distriqt.extension.bumptech.glide.GlideExtension</finalizer>
			</applicationDeployment>
		</platform>
		<platform name="Android-ARM64">
			<applicationDeployment>
